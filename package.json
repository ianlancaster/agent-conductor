{
  "name": "agent-conductor",
  "version": "0.1.0",
  "description": "Lightweight supervisor for terminal coding agents (Claude Code, Codex): pane orchestration, MCP messaging with mechanical identity, event-driven health, stall sentinel, operator channels.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianlancaster/agent-conductor.git"
  },
  "bugs": {
    "url": "https://github.com/ianlancaster/agent-conductor/issues"
  },
  "homepage": "https://github.com/ianlancaster/agent-conductor#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "conductor": "dist/cli/index.js",
    "pr-shepherd": "dist/shepherd/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "prompts",
    "env.template",
    "README.md",
    "CONTRIBUTING.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc",
    "prepack": "pnpm build",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "croner": "^9.0.0",
    "js-yaml": "^4.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.0"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
