# Fleet-local secrets for optional operator channels.
# `conductor start` copies these inert stubs to the fleet environment file on first use
# (new fleets use .conductor/.env).
# You may instead export values from your shell or service environment.

# Telegram
CONDUCTOR_TELEGRAM_TOKEN=
CONDUCTOR_TELEGRAM_CHAT_ID=

# Slack
CONDUCTOR_SLACK_APP_TOKEN=
CONDUCTOR_SLACK_BOT_TOKEN=
CONDUCTOR_SLACK_OPERATOR_USER_ID=
