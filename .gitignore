# No trailing slash: a git worktree is normally set up by symlinking
# node_modules at the shared install, and `node_modules/` matches directories
# only — leaving that symlink untracked, and stageable by `git add -A`.
node_modules
dist/
coverage/
*.log
.env
.DS_Store
/plans
/reviews
AGENTS.override.md
# Running a fleet from a checkout of this repo scaffolds its state here:
# credentials, session config, and the SQLite store. It belongs to that
# deployment, not to the product.
/.conductor/
